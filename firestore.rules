rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRole(role) {
      return getUserRole() == role;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isStaff() {
      return getUserRole() in ['rt', 'faculty', 'hod', 'warden', 'admin'];
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isRole('admin');
    }

    // ─── Leave Requests ───
    match /leave_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isRole('student');
      // Students can only update their own (document uploads); staff can approve/reject
      allow update: if isAuthenticated()
        && (isStaff() || isRole('parent') || isOwner(resource.data.studentId));
    }

    // ─── QR Passes ───
    match /qr_passes/{passId} {
      allow read: if isAuthenticated();
      // Only created during approval flow (by staff/system)
      allow create: if isAuthenticated()
        && (isStaff() || isRole('security'));
      allow update: if isAuthenticated()
        && (isRole('security') || isRole('admin'));
    }

    // ─── Attendance Records ───
    match /attendance_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (isRole('rt') || isRole('warden') || isRole('admin'));
    }

    // ─── Medical Visits ───
    match /medical_visits/{visitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isRole('medical_officer');
      // Medical officer updates records; staff acknowledge intimations; students request review
      allow update: if isAuthenticated()
        && (isRole('medical_officer') || isStaff()
            || isOwner(resource.data.studentId));
    }

    // ─── Grievances ───
    match /grievances/{grievanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isRole('student');
      // Staff can respond/escalate/resolve; students can only view
      allow update: if isAuthenticated() && isStaff();
    }

    // ─── Geofence Sessions ───
    match /geofence_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isRole('rt');
      allow update: if isAuthenticated()
        && (isRole('rt') || isRole('warden') || isRole('admin'));
    }

    // ─── Geofence Check-ins ───
    match /geofence_checkins/{checkInId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isRole('student');
    }

    // ─── Attendance Anomalies ───
    match /attendance_anomalies/{anomalyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && (isRole('rt') || isRole('warden') || isRole('admin'));
      // Staff and parents can update (resolve, respond)
      allow update: if isAuthenticated()
        && (isStaff() || isRole('parent'));
    }

    // ─── Audit Logs ───
    match /audit_logs/{logId} {
      allow read: if isAuthenticated()
        && (isRole('admin') || isRole('warden'));
      allow create: if isAuthenticated();
    }
  }
}
